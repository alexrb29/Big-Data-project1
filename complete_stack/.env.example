# URL del proyecto Supabase (Project Settings → API). No es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Opcional: URL usada por el servidor. Si se omite, se usa NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Clave publicable (sb_publishable_...). La aplicación no la necesita: toda la
# lectura y escritura pasa por el servidor. Se documenta por si se amplía.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA (sb_secret_...) o service_role. Solo servidor: nunca con
# prefijo NEXT_PUBLIC_, nunca en el repositorio.
SUPABASE_SECRET_KEY=

# Las rutas /api usan la clave secreta y no tienen autenticación. En producción
# están bloqueadas salvo que se active esto, después de protegerlas.
ETL_PERMITIR_EN_PRODUCCION=false
